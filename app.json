{
  "expo": {
    "name": "Kova",
    "slug": "kova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.kova"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B1830",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.kova",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.NFC",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kova",
    "backgroundColor": "#1B1830",
    "plugins": [
      "./plugins/withBankAppQueries",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kova uses Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B8A8F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kova uses the camera to read your card details. Photos stay on your phone.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1B1830"
        }
      ]
    ]
  }
}